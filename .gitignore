# Embedded UI build assets (regenerated by npm run build)
internal/server/ui_dist/assets/
# index.html/vite.svg stay tracked (go:embed all:ui_dist in internal/server/spa.go
# needs this dir non-empty on a fresh clone before any frontend build runs) but are
# marked --skip-worktree so a local `npm run build`'s regenerated index.html doesn't
# show as dirty. To pick up a real upstream change to either file: run
# `git update-index --no-skip-worktree internal/server/ui_dist/index.html
# internal/server/ui_dist/vite.svg`, pull, then re-apply --skip-worktree.

# Scratch artifact-tool output (session-local, not build output)
/data/artifacts/

# Plugins
/plugins/

# Badger coordination store (runtime data)
/coordination/

# Agent state (managed by services)
.agentrc/state/
.agentrc/.session-unclean.flag
.claude/worktrees/
.claude/scheduled_tasks.lock
worktrees/
/nanite

# Vite TS-config compile shims (transient)
ui/vite.config.ts.timestamp-*.js

# Visual brainstorming companion sessions
.superpowers/
