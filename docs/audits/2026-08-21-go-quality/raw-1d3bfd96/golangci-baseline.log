	if panelID == "" {
		return mcp.ErrorResult("panel_id is required"), nil
	}
	allowed, reason := st.resolvePanelAccess(ctx, panelID)
	if !allowed {
		return panelResultJSON(map[string]any{
			"opened":   false,
			"panel_id": panelID,
			"reason":   reason,
		}), nil
	}
	st.emitPanelSignal(ctx, args, PanelSignal{
		Action:  "open",
		PanelID: panelID,
		Source:  "agent",
	})
	return panelResultJSON(map[string]any{
		"opened":   true,
		"panel_id": panelID,
	}), nil
}
