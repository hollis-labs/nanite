{
  "$id": "diff-card",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diff Card",
  "description": "A side-by-side before/after comparison.",
  "type": "object",
  "required": [
    "before",
    "after"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Optional diff title."
    },
    "before": {
      "type": "object",
      "required": [
        "label",
        "content"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "The before state."
    },
    "after": {
      "type": "object",
      "required": [
        "label",
        "content"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "The after state."
    },
    "format": {
      "type": "string",
      "enum": [
        "text",
        "code"
      ],
      "description": "Content format. Defaults to text."
    }
  },
  "default_render_target": "bottom_chat_drawer",
  "additionalProperties": false
}
