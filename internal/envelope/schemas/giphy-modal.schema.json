{
  "$id": "giphy-modal",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Giphy Modal",
  "description": "A Giphy GIF display card.",
  "type": "object",
  "required": [
    "title",
    "gif_url",
    "source",
    "query"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Card title."
    },
    "gif_url": {
      "type": "string",
      "description": "URL of the GIF image."
    },
    "source": {
      "type": "string",
      "description": "Attribution source (e.g. GIPHY)."
    },
    "query": {
      "type": "string",
      "description": "The search query used to find this GIF."
    }
  },
  "default_render_target": "bottom_chat_drawer",
  "additionalProperties": false
}
