{
  "$id": "list-card",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "List Card",
  "description": "An ordered or unordered list with optional item actions.",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Optional list title."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "action": {
            "type": "object",
            "required": [
              "label",
              "type"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "description": "List items."
    },
    "ordered": {
      "type": "boolean",
      "description": "Whether to show numbered list. Defaults to false."
    }
  },
  "default_render_target": "bottom_chat_drawer",
  "additionalProperties": false
}
