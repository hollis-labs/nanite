{
  "$id": "metric-card",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric Card",
  "description": "A single metric display with optional trend indicator.",
  "type": "object",
  "required": [
    "label",
    "value"
  ],
  "properties": {
    "label": {
      "type": "string",
      "description": "Metric label."
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "description": "The metric value."
    },
    "unit": {
      "type": "string",
      "description": "Unit suffix (e.g. ms, %, GB)."
    },
    "trend": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "flat"
      ],
      "description": "Trend direction."
    },
    "previous": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "description": "Previous value for comparison."
    },
    "description": {
      "type": "string",
      "description": "Additional context."
    }
  },
  "default_render_target": "bottom_chat_drawer",
  "additionalProperties": false
}
