{
  "$id": "progress-card",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Progress Card",
  "description": "A progress bar with optional step checklist.",
  "type": "object",
  "required": [
    "title",
    "progress"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Progress title."
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Progress percentage (0-100)."
    },
    "status": {
      "type": "string",
      "description": "Current status text."
    },
    "description": {
      "type": "string",
      "description": "Additional description."
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "done"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "description": "Step checklist."
    }
  },
  "default_render_target": "bottom_chat_drawer",
  "additionalProperties": false
}
