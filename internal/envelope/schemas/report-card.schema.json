{
  "$id": "report-card",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report Card",
  "description": "A metrics report with summary and action buttons.",
  "type": "object",
  "required": [
    "title",
    "metrics"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Report title."
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of report generation."
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "percent": {
            "type": "number"
          },
          "color": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Array of metric entries."
    },
    "summary": {
      "type": "string",
      "description": "Markdown summary text shown below metrics."
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "action"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Action buttons shown at the bottom."
    }
  },
  "default_render_target": "bottom_chat_drawer",
  "additionalProperties": false
}
