{
  "$id": "task-complete-notification",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Complete Notification",
  "description": "Notification that a background task or pipeline run has completed.",
  "type": "object",
  "required": ["title", "run_id", "status"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Notification title."
    },
    "run_id": {
      "type": "string",
      "description": "Pipeline run ID."
    },
    "blueprint_id": {
      "type": "string",
      "description": "Blueprint that was executed."
    },
    "status": {
      "type": "string",
      "enum": ["done", "error"],
      "description": "Completion status."
    },
    "completed_at": {
      "type": "string",
      "description": "ISO 8601 completion timestamp."
    },
    "has_output": {
      "type": "boolean",
      "description": "Whether the run produced viewable output."
    },
    "output_preview": {
      "type": "string",
      "description": "Short preview of the output."
    },
    "prompt_text": {
      "type": "string",
      "description": "Prompt text shown next to the action button."
    },
    "report_content": {
      "type": "string",
      "description": "Full report content."
    }
  },
  "additionalProperties": false
}
