{
  "$id": "task-disposition",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Disposition",
  "description": "Batch task disposition card for approving, deferring, or requesting changes.",
  "type": "object",
  "required": ["title", "tasks"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Card title."
    },
    "description": {
      "type": "string",
      "description": "Optional description."
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "priority"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "priority": { "type": "string" }
        },
        "additionalProperties": false
      },
      "description": "Tasks to disposition."
    },
    "actions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Available actions. Defaults to Approve, Done, Request Changes, Defer, Skip."
    }
  },
  "additionalProperties": false
}
