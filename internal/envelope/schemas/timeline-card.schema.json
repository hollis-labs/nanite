{
  "$id": "timeline-card",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline Card",
  "description": "A vertical timeline of events.",
  "type": "object",
  "required": [
    "events"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Optional timeline title."
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "label"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "ISO 8601 timestamp."
          },
          "label": {
            "type": "string",
            "description": "Event label."
          },
          "description": {
            "type": "string",
            "description": "Event description."
          },
          "icon": {
            "type": "string",
            "description": "Icon name."
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "active",
              "pending"
            ],
            "description": "Event status."
          }
        },
        "additionalProperties": false
      },
      "description": "Timeline events in order."
    }
  },
  "default_render_target": "bottom_chat_drawer",
  "additionalProperties": false
}
