func init() {
	hostplugin.RegisterPlugin("{{.PluginID}}", func() plugin.Plugin { return New() })
}

// {{.StructName}} implements the {{.PluginName}} plugin for Conduit.
type {{.StructName}} struct {
	host   plugin.Host
	status plugin.PluginStatus
}

// New creates a new {{.StructName}} instance.
func New() *{{.StructName}} {
	return &{{.StructName}}{}
}

func (p *{{.StructName}}) ID() string          { return "{{.PluginID}}" }
func (p *{{.StructName}}) Name() string        { return "{{.PluginName}}" }
func (p *{{.StructName}}) Version() string     { return "0.1.0" }
func (p *{{.StructName}}) Description() string { return "{{.Description}}" }
func (p *{{.StructName}}) Dependencies() []string { return nil }

func (p *{{.StructName}}) Load(host plugin.Host) error {
	p.host = host
	logger := host.Logger()

	// Register config schema — frontend renders a settings form from these fields.
	if err := host.RegisterConfigSchema([]plugin.ConfigFieldDef{
		{Key: "enabled", Type: "bool", Label: "Enable Plugin", Default: true},
		// Add your config fields here:
		// {Key: "api_key", Type: "secret", Label: "API Key", Required: true},
		// {Key: "mode", Type: "select", Label: "Mode", Options: []string{"fast", "balanced", "thorough"}},
	}); err != nil {
		logger.Warn("failed to register config schema", "error", err)
	}

	// Register event hooks — react to system events.
	hook := &{{.StructName}}Hook{plugin: p}
	if err := host.RegisterEventHook(hook.EventTypes(), hook); err != nil {
		return fmt.Errorf("failed to register event hook: %%w", err)
	}
{{- range .CRUDResources}}

	// Register CRUD handler for {{.}} — auto-wires /api/plugins/{{.}}/*
	{{.}}Handler := &{{title .}}Handler{}
	if err := host.RegisterCRUDHandler("{{.}}", {{.}}Handler); err != nil {
		return fmt.Errorf("failed to register {{.}} CRUD handler: %%w", err)
	}
{{- end}}

	p.status = plugin.PluginStatus{
		Loaded:   true,
		Enabled:  true,
		LoadedAt: time.Now(),
	}

	logger.Info("{{.PluginID}} plugin loaded", "version", p.Version())
	return nil
}

func (p *{{.StructName}}) Unload() error {
	p.status.Loaded = false
	p.status.Enabled = false
	if p.host != nil {
		p.host.Logger().Info("{{.PluginID}} plugin unloaded")
	}
	return nil
}

func (p *{{.StructName}}) Status() plugin.PluginStatus {
	return p.status
}

// {{.StructName}}Hook processes events for this plugin.
type {{.StructName}}Hook struct {
	plugin *{{.StructName}}
}

func (h *{{.StructName}}Hook) EventTypes() []string {
	return []string{"message.sent", "session.start"}
}

func (h *{{.StructName}}Hook) Handle(ctx context.Context, event plugin.Event) error {
	logger := h.plugin.host.Logger()
	switch event.Type {
	case "message.sent":
		logger.Debug("message sent", "session", event.SessionID)
	case "session.start":
		logger.Debug("session started", "session", event.SessionID)
	}
	return nil
}
