PLUGIN_ID := {{.Name}}
VERSION   := 0.1.0
PLATFORMS := darwin-arm64 darwin-amd64 linux-amd64 linux-arm64

DIST_DIR     := dist
STAGING_DIR  := $(DIST_DIR)/staging
ARCHIVES_DIR := $(DIST_DIR)/archives

# Files copied verbatim into every per-platform archive.
ARCHIVE_CONTENTS := envelopes README.md LICENSE CHANGELOG.md

.PHONY: all build dev build-ui build-go release clean

all: release

# Native installable bundle. Generate its manifest from the built bytes.
build dev: build-ui
	@set -e; stage=$(DIST_DIR)/native; \
		mkdir -p $$stage/bin $$stage/ui/dist; \
		cp -r $(ARCHIVE_CONTENTS) $$stage/; \
		cp -r ui/dist/. $$stage/ui/dist/; \
		CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o $$stage/bin/$(PLUGIN_ID) .; \
		go run . --manifest $$stage bin/$(PLUGIN_ID) > $$stage/plugin.yaml

build-ui:
	cd ui && npm install --no-audit --no-fund --silent && npm run build

build-go:
	@rm -rf $(STAGING_DIR)
	@mkdir -p $(STAGING_DIR)
	@set -e; for plat in $(PLATFORMS); do \
		os=$${plat%-*}; arch=$${plat#*-}; \
		if [ "$$os" = "windows" ]; then bin=$(PLUGIN_ID).exe; else bin=$(PLUGIN_ID); fi; \
		echo ">> building $$os/$$arch"; \
		mkdir -p $(STAGING_DIR)/$$plat/bin; \
		GOOS=$$os GOARCH=$$arch CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
			-o $(STAGING_DIR)/$$plat/bin/$$bin .; \
	done

# `release` stages each per-platform archive with the same layout the
# host unpacks on install. The manifest inventories the platform binary,
# UI assets and documentation after staging is complete.
release: build-ui build-go
	@mkdir -p $(ARCHIVES_DIR)
	@set -e; for plat in $(PLATFORMS); do \
		os=$${plat%-*}; arch=$${plat#*-}; \
		if [ "$$os" = "windows" ]; then bin=$(PLUGIN_ID).exe; else bin=$(PLUGIN_ID); fi; \
		stage=$(STAGING_DIR)/$$plat; \
		echo ">> assembling $$plat archive"; \
		cp -r $(ARCHIVE_CONTENTS) $$stage/; \
		mkdir -p $$stage/ui/dist; \
		cp -r ui/dist/. $$stage/ui/dist/; \
		go run . --manifest $$stage bin/$$bin > $$stage/plugin.yaml; \
		archive=$(ARCHIVES_DIR)/$(PLUGIN_ID)-$(VERSION)-$$plat.tar.gz; \
		tar -C $$stage -czf $$archive .; \
		if command -v sha256sum >/dev/null 2>&1; then \
			sha256sum $$archive | awk '{print $$1}' > $$archive.sha256; \
		elif command -v shasum >/dev/null 2>&1; then \
			shasum -a 256 $$archive | awk '{print $$1}' > $$archive.sha256; \
		else \
			echo "error: neither sha256sum nor shasum is available" >&2; \
			exit 1; \
		fi; \
	done

clean:
	rm -rf $(DIST_DIR) ui/dist ui/node_modules
