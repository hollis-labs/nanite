// {{.DisplayName}} is a Nanite subprocess plugin scaffolded by
// `nanite plugin new --subprocess {{.Name}}`. It speaks JSON-RPC over
// stdio to the Nanite host via the libs/plugin-mcp v0.2.0 protocol 2 server.
package main

import (
	"context"
 "crypto/sha256"
 "encoding/hex"
 "io/fs"
 "path/filepath"
	"encoding/json"
	"fmt"
	"os"
"github.com/hollis-labs/libs/plugin-mcp/plugin-sdk/manifest"

	plugin "github.com/hollis-labs/libs/plugin-mcp/plugin-sdk"
	"github.com/hollis-labs/libs/plugin-mcp/plugin-sdk/subprocess"
)

const envelopeType = "{{.EnvelopeType}}"

// {{.StructName}} implements subprocess.Plugin plus the optional
// CommandHandler and MCPHandler capability interfaces.
type {{.StructName}} struct{}

func (p *{{.StructName}}) Init(ctx context.Context, params subprocess.InitParams) (subprocess.InitResult, error) {
	return subprocess.InitResult{
		ID:          "{{.Name}}",
		Name:        "{{.DisplayName}}",
		Version:     "0.1.0",
		Description: "{{.Description}}",
		Protocol:    subprocess.ProtocolVersion,
	}, nil
}

func (p *{{.StructName}}) Load(ctx context.Context) (subprocess.LoadResult, error) {
	return subprocess.LoadResult{}, nil
}

func (p *{{.StructName}}) Unload(ctx context.Context) error { return nil }

// Command handles /{{.Name}} <text>. It echoes the argument back both as
// message content and as a structured envelope for the chat surface.
func (p *{{.StructName}}) Command(ctx context.Context, req subprocess.CommandRequest) (subprocess.CommandResult, error) {
	text := req.Args
	if text == "" {
		text = "hello from {{.DisplayName}}"
	}
	env := plugin.EnvelopeOut{
		Type: envelopeType,
		Data: map[string]interface{}{
			"text": text,
		},
	}
	return subprocess.CommandResult{
		Action:    "message",
		Content:   text,
		Envelopes: []plugin.EnvelopeOut{env},
	}, nil
}

// MCPCallTool handles the shared manifest's declared echo tool.
func (p *{{.StructName}}) MCPCallTool(ctx context.Context, req subprocess.MCPCallRequest) (subprocess.MCPCallResult, error) {
	switch req.ToolName {
	case "echo":
		text, _ := req.Arguments["text"].(string)
		if text == "" {
			text = "hello from {{.DisplayName}}"
		}
		payload, err := json.Marshal(map[string]interface{}{
			"echoed": text,
		})
		if err != nil {
			return mcpError(fmt.Sprintf("marshal result: %v", err))
		}
		env := plugin.EnvelopeOut{
			Type: envelopeType,
			Data: map[string]interface{}{"text": text},
		}
		return subprocess.MCPCallResult{
			Content:   payload,
			Envelopes: []plugin.EnvelopeOut{env},
		}, nil
	default:
		return mcpError(fmt.Sprintf("unknown tool %q", req.ToolName))
	}
}

func mcpError(msg string) (subprocess.MCPCallResult, error) {
	payload, _ := json.Marshal(map[string]string{"error": msg})
	return subprocess.MCPCallResult{Content: payload, IsError: true}, nil
}

// declaration inventories a completed bundle, never guessed artifact hashes.
func declaration(root, entry string) (manifest.Manifest, error) {
 m := manifest.Manifest{SchemaVersion:2,ID:{{quote .Name}},Name:{{quote .DisplayName}},Version:"0.1.0",Description:{{quote .Description}},License:"MIT",Protocol:subprocess.ProtocolVersion,Runtime:manifest.Runtime,
 Server:manifest.Server{Runtime:"binary",Engines:map[string]manifest.HostRange{"binary":{Min:"0.0.0"}},Entry:entry},UI:&manifest.UI{Bundle:"ui/dist/index.js",Isolation:"main-origin"},Hosts:map[string]manifest.HostRange{"nanite":{Min:"0.2.0"}},Nanite:json.RawMessage({{quote .NaniteBlock}}),Tools:[]manifest.Tool{ {{ "{" }}Name:"echo",Description:"Echo text",InputSchema:json.RawMessage(`{"type":"object","properties":{"text":{"type":"string"}},"additionalProperties":false}`),Effect:"read"{{ "}" }} } }
 err := filepath.WalkDir(root,func(path string, d fs.DirEntry, err error) error {
  if err != nil {return err}
  if d.IsDir() {return nil}
  if !d.Type().IsRegular() {return fmt.Errorf("bundle contains a non-regular file")}
  rel, err := filepath.Rel(root,path)
  if err != nil {return err}
  rel = filepath.ToSlash(rel)
  if rel == manifest.Filename {return nil}
  data, err := os.ReadFile(path)
  if err != nil {return err}
  info, err := d.Info()
  if err != nil {return err}
  sum := sha256.Sum256(data)
  m.Artifact.Files = append(m.Artifact.Files,manifest.ArtifactFile{Path:rel,SHA256:hex.EncodeToString(sum[:]),Executable:info.Mode().Perm()&0111 != 0})
  return nil
 })
 if err != nil {return manifest.Manifest{},err}
 m.Artifact.TreeSHA256, err = manifest.TreeDigest(m.Artifact.Files)
 return m,err
}

func main() {
 if len(os.Args) == 4 && os.Args[1] == "--manifest" {
  m, err := declaration(os.Args[2],os.Args[3])
  if err == nil { err = manifest.Encode(os.Stdout,m) }
  if err != nil { fmt.Fprintln(os.Stderr,err); os.Exit(1) }
  return
 }
	if err := subprocess.Serve(&{{.StructName}}{}); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}
