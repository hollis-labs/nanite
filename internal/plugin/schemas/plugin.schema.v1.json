{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanite.hollis-labs.dev/schemas/plugin.schema.v1.json",
  "title": "Nanite plugin.yaml v1",
  "description": "Schema for plugin.yaml authored by plugin developers. v1 makes plugin.yaml authoritative for registrations.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "author",
    "license",
    "runtime",
    "protocol",
    "nanite_compat"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "description": { "type": "string", "minLength": 1 },
    "short_desc": { "type": "string" },
    "author": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "license": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string" },
    "protocol": { "type": "integer", "minimum": 1 },
    "runtime": {
      "type": "string",
      "enum": ["subprocess", "builtin"]
    },
    "entrypoint": { "type": "string" },
    "load_type": {
      "type": "string",
      "enum": ["auto", "opt-in", ""]
    },
    "nanite_compat": {
      "type": "object",
      "required": ["min"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "string" },
        "max": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "secret", "bool", "int", "select", "multiline"]
          },
          "required": { "type": "boolean" },
          "env_var": { "type": "string" },
          "default": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp_servers": { "type": "array", "items": { "type": "string" } },
        "plugins":     { "type": "array", "items": { "type": "string" } },
        "features":    { "type": "array", "items": { "type": "string" } }
      }
    },
    "registers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "envelopes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "component"],
            "additionalProperties": false,
            "properties": {
              "type":      { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "component": { "type": "string", "minLength": 1 },
              "version":   { "type": "integer", "minimum": 1 },
              "schema":    { "type": "string" }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name":        { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "description": { "type": "string" },
              "hidden":      { "type": "boolean" },
              "handler":     { "type": "string" },
              "aliases":     { "type": "array", "items": { "type": "string" } },
              "args": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "additionalProperties": false,
                  "properties": {
                    "name":        { "type": "string" },
                    "type":        { "type": "string" },
                    "required":    { "type": "boolean" },
                    "description": { "type": "string" },
                    "default":     { "type": "string" }
                  }
                }
              },
              "metadata": { "type": "object" }
            }
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slot", "id", "component"],
            "additionalProperties": false,
            "properties": {
              "slot":      { "type": "string" },
              "id":        { "type": "string" },
              "component": { "type": "string" },
              "priority":  { "type": "integer" },
              "props":     { "type": "object" }
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name":        { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$" },
              "type":        { "type": "string", "enum": ["widget", "envelope", "action", "workflow", "view"] },
              "description": { "type": "string" },
              "export":      { "type": "string" }
            }
          }
        },
        "keybindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "keys"],
            "additionalProperties": false,
            "properties": {
              "id":          { "type": "string" },
              "keys":        { "type": "string" },
              "description": { "type": "string" },
              "command":     { "type": "string" },
              "when":        { "type": "string" }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["types"],
            "additionalProperties": false,
            "properties": {
              "types":    { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "handler":  { "type": "string" },
              "priority": { "type": "integer" }
            }
          }
        },
        "crud": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["resource"],
            "additionalProperties": false,
            "properties": {
              "resource": { "type": "string" },
              "methods":  { "type": "array", "items": { "type": "string", "enum": ["create", "read", "update", "delete", "list"] } }
            }
          }
        },
        "http_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pattern", "method"],
            "additionalProperties": false,
            "properties": {
              "pattern": { "type": "string" },
              "method":  { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"] },
              "handler": { "type": "string" }
            }
          }
        },
        "mcp_servers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name":        { "type": "string" },
              "description": { "type": "string" },
              "tools":       { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "agent_profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "file"],
            "additionalProperties": false,
            "properties": {
              "id":   { "type": "string" },
              "file": { "type": "string" }
            }
          }
        },
        "card_rules": {
          "description": "Stage 1 card detection rules. Each rule maps a regex pattern or JSON Schema match to a card type. Plugin rules run after built-in rules and can only add new card types, not override built-ins.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["card_type"],
            "additionalProperties": false,
            "properties": {
              "card_type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Envelope type emitted when this rule matches."
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "description": "RE2-compatible regex matched against the full agent output text. Mutually exclusive with output_schema."
              },
              "output_schema": {
                "type": "string",
                "minLength": 1,
                "description": "Relative path (within the plugin dir) to a JSON Schema file. The output is parsed as JSON and validated against the schema. Mutually exclusive with pattern."
              },
              "description": {
                "type": "string",
                "description": "Optional human-readable documentation for this rule."
              }
            }
          }
        },
        "panels": {
          "description": "Right-rail v2 panel contributions (J9). Each entry declares a panel the plugin adds to the right-rail tab strip. Plugin panels can register but render a placeholder in v1; full render function is a follow-up. Trust gate: install-time (H1); runtime panel_register is not supported in v1.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Stable panel identifier. Referenced by J8 panel_open / panel_close."
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable tab label shown in the right-rail tab strip."
              },
              "default_visible": {
                "type": "boolean",
                "description": "Whether the panel appears in the tab strip by default. Plugin panels default to false."
              },
              "icon": {
                "type": "string",
                "description": "Optional Lucide icon name (e.g. 'layers', 'file-text'). Falls back to generic Layers icon when omitted."
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "description": "Sort order hint. Plugin panels default to 100+; lower values appear first."
              },
              "description": {
                "type": "string",
                "description": "Optional human-readable description shown in the Panels settings panel."
              }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundle_dir":     { "type": "string" },
        "entry":          { "type": "string" },
        "stylesheet":     { "type": "string" },
        "assets_dir":     { "type": "string" },
        "react_version":  { "type": "string" },
        "shadcn_version": { "type": "string" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "archive_url":   { "type": "string", "format": "uri" },
        "checksum_url":  { "type": "string", "format": "uri" },
        "signature_url": { "type": "string", "format": "uri" },
        "platforms":     { "type": "array", "items": { "type": "string" } }
      }
    },
    "tool_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "load_type": { "type": "string", "enum": ["auto", "opt-in"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "runtime": { "const": "subprocess" } },
        "required": ["runtime"]
      },
      "then": {
        "required": ["entrypoint"],
        "properties": { "entrypoint": { "minLength": 1 } }
      }
    }
  ]
}
