{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "tool-package/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^agt_[A-Za-z0-9]+/[a-z0-9-]+@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "pattern": "^agt_[A-Za-z0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "pattern": "^cas://sha256/[0-9a-f]{64}$"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "command",
            "mcp"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "audience": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/*-]*$"
            },
            "uniqueItems": true,
            "maxItems": 256
          },
          "env": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "uniqueItems": true,
            "maxItems": 256
          }
        },
        "required": [
          "audience",
          "scopes",
          "env"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "env": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "provenance": {
      "type": "object",
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1,
          "pattern": "^msg://agent/[^\\s/]+/agt_[A-Za-z0-9]+$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "publisher"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "id",
    "publisher",
    "name",
    "version",
    "digest",
    "artifact",
    "entry",
    "execution",
    "needs",
    "env",
    "provenance"
  ],
  "additionalProperties": false
}
