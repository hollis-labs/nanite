<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/mac-nanite/mac-nanite.sh render fills @HOME@, @USER@, @PATH@, @WORKDIR@, @WORKSPACE@.
     Nothing here is a secret; provider keys come from the login keychain or file refs, not from this file. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hollis-labs.nanite.mac</string>

    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.local/bin/nanite</string>
        <string>serve</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@WORKDIR@</string>

    <!-- Start as soon as it is loaded (bootstrap). Whether it is loaded at login is decided by where the
         plist lives: ~/Library/LaunchAgents loads at login (autostart), ~/.local/share/nanite/launchd does not. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Crash recovery: restart after a crash or a signal, not after a clean exit (nanite stop / SIGTERM handled). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ExitTimeOut</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/nanite/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/nanite/stderr.log</string>

    <!-- Explicit, clean environment. No session variables are inherited from a shell. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>USER</key>
        <string>@USER@</string>
        <key>LOGNAME</key>
        <string>@USER@</string>
        <key>PATH</key>
        <string>@PATH@</string>
        <key>NANITE_WORKSPACE</key>
        <string>@WORKSPACE@</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
